<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/dedl#"
     xml:base="https://w3id.org/dedl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/dedl">
        <owl:versionIRI rdf:resource="https://w3id.org/dedl/1.0.0"/>
        <terms:abstract xml:lang="en">DEDL-O is a reusable ontology for describing the technical architecture of data ecosystems, their processes and the connection between both. This integration layer states which process step calls which API endpoint and how data is mapped between them, which neither architecture nor process vocabularies can express on their own.</terms:abstract>
        <terms:bibliographicCitation xml:lang="en">Lennart Klöpper, Jiahang Chen. Data Ecosystem Description Language Ontology (DEDL-O). Version 1.0.0. https://w3id.org/dedl/1.0.0</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-01</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-5970-6954"/>
        <terms:creator rdf:resource="https://orcid.org/0009-0002-5632-5464"/>
        <terms:description xml:lang="en">An ontology for describing the technical architecture, processes and API integration of data ecosystems.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-08</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-08</terms:modified>
        <terms:publisher rdf:resource="https://www.mmi.rwth-aachen.de/"/>
        <terms:title xml:lang="en">Data Ecosystem Description Language Ontology (DEDL-O)</terms:title>
        <vann:preferredNamespacePrefix>dedl</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/dedl#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">DEDL-O</rdfs:label>
        <owl:incompatibleWith rdf:resource="https://w3id.org/dedl/0.1"/>
        <owl:priorVersion rdf:resource="https://w3id.org/dedl/0.1"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- https://schema.org/affiliation -->


    <owl:AnnotationProperty rdf:about="https://schema.org/affiliation"/>
    


    <!-- https://schema.org/email -->


    <owl:AnnotationProperty rdf:about="https://schema.org/email"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/dedl#accessControlModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#accessControlModel">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Policy"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AccessControlModel"/>
        <rdfs:comment xml:lang="en">Associates a Policy with its AccessControlModel to define and enforce resource access rules.</rdfs:comment>
        <rdfs:label xml:lang="en">accessControlModel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authenticationFactor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authenticationFactor">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authenticator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthenticationFactor"/>
        <rdfs:comment xml:lang="en">Indicates the AuthenticationFactor that an Authenticator uses.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationFactor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authenticationPattern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authenticationPattern">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authenticator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthenticationPattern"/>
        <rdfs:comment xml:lang="en">Indicates the interaction pattern an Authenticator uses to verify an identity, e.g. one-way or mutual. Replaces authenticationProcess, whose range mixed patterns with concrete Processes.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationPattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authenticationProtocol -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authenticationProtocol">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authenticator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthenticationProtocol"/>
        <rdfs:comment xml:lang="en">Specifies the AuthenticationProtocol an Authenticator follows.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationProtocol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authenticationRiskContext -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authenticationRiskContext">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authenticator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthenticationRiskContext"/>
        <rdfs:comment xml:lang="en">Associates an Authenticator with contextual factors that influence authentication risk.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationRiskContext</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authenticationScheme -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authenticationScheme">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthenticationScheme"/>
        <rdfs:comment xml:lang="en">Specifies how the credentials are carried when calling the endpoint, e.g. as a bearer token.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationScheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authorizationArchitecture -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authorizationArchitecture">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authorizator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthorizationArchitecture"/>
        <rdfs:comment xml:lang="en">Specifies the AuthorizationArchitecture used by an Authorizator.</rdfs:comment>
        <rdfs:label xml:lang="en">authorizationArchitecture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#authorizationPattern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#authorizationPattern">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Authorizator"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#AuthorizationPattern"/>
        <rdfs:comment xml:lang="en">Indicates the interaction pattern an Authorizator follows to reach and deliver an access decision, e.g. poll or push. Replaces authorizationProcess, whose range mixed patterns with concrete Processes.</rdfs:comment>
        <rdfs:label xml:lang="en">authorizationPattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#byDataEcosystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#byDataEcosystem">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#process"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:comment xml:lang="en">Indicates the Process belonging to a DataEcosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">byDataEcosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#composedOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#composedOf">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#partOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:comment xml:lang="en">Indicates if the data ecosystem consists of multiple data ecosystem</rdfs:comment>
        <rdfs:label xml:lang="en">composedOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#correspondsToDataProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#correspondsToDataProperty">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
        <rdfs:comment xml:lang="en">Associates a BBO:DataResource with an expected Property in another vocabulary (e.g. schema:legalName).</rdfs:comment>
        <rdfs:label xml:lang="en">correspondsToDataProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#correspondsToThing -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#correspondsToThing">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Associates a BBO:DataResource with an expected Thing/Class in another vocabulary (e.g. vc:VerifiableCredential).</rdfs:comment>
        <rdfs:label xml:lang="en">correspondsToThing</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#dataEcosystemElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#dataEcosystemElement">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#inDataEcosystem"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#DataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Links a DataEcosystem to an element belonging to it (inverse of inDataEcosystem). Specialised by participant and technicalDataEcosystemElement, so that membership needs to be stated in one direction only.</rdfs:comment>
        <rdfs:label xml:lang="en">dataEcosystemElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#dependsOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#dependsOn">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Indicates that a TechnicalDataEcosystemElement needs or uses another one to fulfil its function, e.g. by calling its API, storing data in it or delegating authentication to it. Directed from the dependent element to the one it depends on; only direct dependencies are stated. What the dependency is for mostly follows from the type of the target (e.g. DataStorage, IdentityProvider). How it is realised, and in which direction data travels, belongs to the integration layer (invokesEndpoint, exposedBy). This allows the system architecture to be described coarsely before any Process is modelled in detail.</rdfs:comment>
        <rdfs:label xml:lang="en">dependsOn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#endpoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#endpoint">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:comment xml:lang="en">Associates a TechnicalDataEcosystemElement with an Endpoint resource that contains connection details (path, method, auth, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">endpoint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#entity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#entity">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#inParticipant"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Entity"/>
        <rdfs:comment xml:lang="en">Associates a Participant with a particular Entity in the data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#evaluatesDataResource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#evaluatesDataResource">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Expression"/>
        <rdfs:range rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
        <rdfs:comment xml:lang="en">Associates an Expression with a DataResource it evaluates. BBO offers no such link: conditions are opaque text in BBO:body, and the only DataResource-valued properties are bound to Throw- and CatchEvents. Identifiers used inside the body are the @id of the referenced resources, which makes the pair body/evaluatesDataResource machine-checkable.</rdfs:comment>
        <rdfs:label xml:lang="en">evaluatesDataResource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#exposedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#exposedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#endpoint"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Indicates the TechnicalDataEcosystemElement exposing this endpoint. The range is not restricted to API, because components with a more specific functional type (e.g. an IdentityProvider) carry their own endpoints directly.</rdfs:comment>
        <rdfs:label xml:lang="en">exposedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#httpLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#httpLocation">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#HttpParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#HttpLocation"/>
        <rdfs:comment xml:lang="en">Indicates where in the HTTP request a parameter is placed. Body content is not covered here; it is described through requestHttpBodySchema.</rdfs:comment>
        <rdfs:label xml:lang="en">httpLocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#httpParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#httpParameter">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#HttpParameter"/>
        <rdfs:comment xml:lang="en">Associates an Endpoint with a parameter carried in the request path or headers.</rdfs:comment>
        <rdfs:label xml:lang="en">httpParameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#httpResponse -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#httpResponse">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#HttpResponse"/>
        <rdfs:comment xml:lang="en">Associates an Endpoint with one of the responses it may return.</rdfs:comment>
        <rdfs:label xml:lang="en">httpResponse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#identity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#identity">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/didl#Identity"/>
        <rdfs:comment xml:lang="en">Indicates the Identity belonging to an Entity.</rdfs:comment>
        <rdfs:label xml:lang="en">identity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#inDataEcosystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#inDataEcosystem">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:comment xml:lang="en">Indicates the DataEcosystem a DataEcosystemElement belongs to (inverse of dataEcosystemElement).</rdfs:comment>
        <rdfs:label xml:lang="en">inDataEcosystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#inParticipant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#inParticipant">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">Indicates the Entity belonging to a Participant.</rdfs:comment>
        <rdfs:label xml:lang="en">inParticipant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#insertsDataResource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#insertsDataResource">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:range rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
        <rdfs:comment xml:lang="en">Lists a DataResource whose value is inserted into the valueTemplate of this mapping. Used only together with valueTemplate; the placeholders of the template and the listed resources correspond one to one. Kept apart from source and evaluatesDataResource so that each property has a single meaning.</rdfs:comment>
        <rdfs:label xml:lang="en">insertsDataResource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#invokesEndpoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#invokesEndpoint">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:comment xml:lang="en">Indicates that a task invokes an API endpoint.</rdfs:comment>
        <rdfs:label xml:lang="en">invokesEndpoint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#mapsInput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#mapsInput">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:comment xml:lang="en">Associates a Task with a mapping that fills a field of the request it sends. BBO has no DataAssociations, so the wiring between process data and message fields has no equivalent there.</rdfs:comment>
        <rdfs:label xml:lang="en">mapsInput</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#mapsOutput -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#mapsOutput">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:comment xml:lang="en">Associates a Task with a mapping that reads a field of the response into a DataResource of the process.</rdfs:comment>
        <rdfs:label xml:lang="en">mapsOutput</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#memberOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#memberOf">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Individual"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Organization"/>
        <rdfs:comment xml:lang="en">Links an Individual to an Organization.</rdfs:comment>
        <rdfs:label xml:lang="en">memberOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#operatedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#operatedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#operates"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">Indicates the Participant responsible for the technical operation and maintenance of a TechnicalDataEcosystemElement (inverse of operates). Not to be confused with operator, which denotes the governance of the whole DataEcosystem. The infrastructure provider underneath (e.g. a cloud hoster) is not the operator in this sense.</rdfs:comment>
        <rdfs:label xml:lang="en">operatedBy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/idsa/core/maintainer"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#operates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#operates">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Links a Participant to a TechnicalDataEcosystemElement it operates (inverse of operatedBy).</rdfs:comment>
        <rdfs:label xml:lang="en">operates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#operator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#operator">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dedl#participant"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">Specifies a Participant responsible for governing the DataEcosystem as a whole, e.g. setting its rules and admitting participants. Every operator is also a participant. Not to be confused with operatedBy, which denotes the technical operation of a single TechnicalDataEcosystemElement.</rdfs:comment>
        <rdfs:label xml:lang="en">operator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#optionalInputRef -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#optionalInputRef">
        <rdfs:domain rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#InputSet"/>
        <rdfs:range rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
        <rdfs:comment xml:lang="en">Marks a DataResource referenced by an InputSet as one that may be omitted. Named after the BPMN attribute optionalInputRefs, which BBO does not carry over. Optionality is stated per InputSet rather than on the resource itself, because the same resource can be mandatory in one context and optional in another. Expressing optionality through several alternative InputSets instead would grow combinatorially.</rdfs:comment>
        <rdfs:label xml:lang="en">optionalInputRef</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#partOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#partOf">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:comment xml:lang="en">Indicates if the data ecosystem is part of another data ecosystem</rdfs:comment>
        <rdfs:label xml:lang="en">partOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#participant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#participant">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dedl#dataEcosystemElement"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">Specifies a participant within a DataEcosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#policy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#policy">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Policy"/>
        <rdfs:comment xml:lang="en">Links an Entity to a Policy governing its usage or access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">policy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#policyLanguage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#policyLanguage">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Policy"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#PolicyLanguage"/>
        <rdfs:comment xml:lang="en">Specifies the PolicyLanguage used to express or encode a Policy.</rdfs:comment>
        <rdfs:label xml:lang="en">policyLanguage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#process -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#process">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">Associates a DataEcosystem with a particular Process.</rdfs:comment>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#requestHttpBodySchema -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#requestHttpBodySchema">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="https://www.w3.org/2019/wot/json-schema#DataSchema"/>
        <rdfs:comment xml:lang="en">Describes the structure of the request body of an endpoint. The encoding of that body is stated separately via hctl:forContentType.</rdfs:comment>
        <rdfs:label xml:lang="en">requestHttpBodySchema</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#responseHttpBodySchema -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#responseHttpBodySchema">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#HttpResponse"/>
        <rdfs:range rdf:resource="https://www.w3.org/2019/wot/json-schema#DataSchema"/>
        <rdfs:comment xml:lang="en">Describes the structure of the body returned with a response.</rdfs:comment>
        <rdfs:label xml:lang="en">responseHttpBodySchema</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#source -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#source">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:comment xml:lang="en">Where a mapped value is taken from; alternatively the value is fixed by constantValue or built by valueTemplate. Deliberately without rdfs:range: with mapsInput the source is a BBO:DataResource, with mapsOutput it is a field of the response schema. Since rdfs:range is an inference rule rather than a constraint, a union would only add uninformative type assertions, and the actual rule is conditional on the direction of the mapping. That rule belongs in SHACL.</rdfs:comment>
        <rdfs:label xml:lang="en">source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#status -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#status">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Status"/>
        <rdfs:comment xml:lang="en">Associates TechnicalDataEcosystemElement with their current state-</rdfs:comment>
        <rdfs:label xml:lang="en">status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#target -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#target">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:comment xml:lang="en">Where a mapped value is written to. Deliberately without rdfs:range, for the same reason as source: with mapsInput the target is an HttpParameter, a field of the request schema, or the request schema itself when the whole document is the value; with mapsOutput it is a BBO:DataResource.</rdfs:comment>
        <rdfs:label xml:lang="en">target</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#technicalDataEcosystemElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#technicalDataEcosystemElement">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/dedl#dataEcosystemElement"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Links a DataEcosystem to a TechnicalDataEcosystemElement belonging to it.</rdfs:comment>
        <rdfs:label xml:lang="en">technicalDataEcosystemElement</rdfs:label>
        <rdfs:seeAlso xml:lang="en">composedBy (Oliveira)</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#usedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#usedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/dedl#uses"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">Indicates the Participant using a TechnicalDataEcosystemElement (inverse of uses).</rdfs:comment>
        <rdfs:label xml:lang="en">usedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#uses -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#uses">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">Links a Participant to a TechnicalDataEcosystemElement it uses (inverse of usedBy).</rdfs:comment>
        <rdfs:label xml:lang="en">uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/dedl#valueEncoding -->


    <owl:ObjectProperty rdf:about="https://w3id.org/dedl#valueEncoding">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#HttpParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/dedl#ParameterEncoding"/>
        <rdfs:comment xml:lang="en">States that the endpoint requires the value of this parameter to be transformed before it is placed into the request, e.g. base64url-encoded in a path. The transformation belongs to the endpoint, not to the mapping: a mapping states which value is meant, this property how it is carried.</rdfs:comment>
        <rdfs:label xml:lang="en">valueEncoding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/dcat#endpointURL -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#endpointURL"/>
    


    <!-- https://schema.org/description -->


    <owl:DatatypeProperty rdf:about="https://schema.org/description"/>
    


    <!-- https://schema.org/httpMethod -->


    <owl:DatatypeProperty rdf:about="https://schema.org/httpMethod"/>
    


    <!-- https://schema.org/name -->


    <owl:DatatypeProperty rdf:about="https://schema.org/name"/>
    


    <!-- https://schema.org/urlTemplate -->


    <owl:DatatypeProperty rdf:about="https://schema.org/urlTemplate"/>
    


    <!-- https://w3id.org/dedl#authenticationRequired -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#authenticationRequired">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether authentication is required to call the endpoint.</rdfs:comment>
        <rdfs:label xml:lang="en">authenticationRequired</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#constantValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#constantValue">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">A fixed value written to the target of the mapping instead of a value read from a source; used with mapsInput. The literal keeps its datatype, e.g. string, number or boolean. Not reused from schema:value, which is defined for QuantitativeValue and PropertyValue nodes.</rdfs:comment>
        <rdfs:label xml:lang="en">constantValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#containerImage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#containerImage">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Container image reference from which the element is deployed, including registry and tag.</rdfs:comment>
        <rdfs:label xml:lang="en">containerImage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#parameterName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#parameterName">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#HttpParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Literal name of an HttpParameter as it appears in the request, i.e. the header field name or the path variable name, which must match the API exactly. Not reused from the W3C HTTP vocabulary because htv:fieldName is restricted to header fields and htv:paramName denotes a parameter inside a deconstructed header value, whereas HttpParameter abstracts over the location. schema:name stays reserved for human-readable labels.</rdfs:comment>
        <rdfs:label xml:lang="en">parameterName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#path -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#path">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/urlTemplate"/>
        <rdfs:domain rdf:resource="https://w3id.org/dedl#Endpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Relative HTTP path of an endpoint.</rdfs:comment>
        <rdfs:label xml:lang="en">path</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#statusCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#statusCode">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#HttpResponse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">HTTP status code of a response, e.g. 201 or 404.</rdfs:comment>
        <rdfs:label xml:lang="en">statusCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/dedl#valueTemplate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/dedl#valueTemplate">
        <rdfs:domain rdf:resource="https://w3id.org/dedl#ParameterMapping"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Builds the mapped value from fixed text and inserted values instead of reading it from a source; used with mapsInput. A template contains at least one placeholder; values without any are expressed by constantValue. A placeholder {id} names the @id of a BBO:DataResource in an InputSet of the mapping Task and listed via insertsDataResource; its value is inserted as is, without any encoding, and the result is always a string. Not reused from URI Templates (RFC 6570), because their expansion percent-encodes, which is correct for URIs but wrong for message bodies. Computations beyond insertion are deliberately out of scope.</rdfs:comment>
        <rdfs:label xml:lang="en">valueTemplate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3.org/2019/wot/hypermedia#forContentType -->


    <owl:DatatypeProperty rdf:about="https://www.w3.org/2019/wot/hypermedia#forContentType">
        <rdfs:comment xml:lang="en">Used on Endpoint to state the media type of the request body, e.g. application/x-www-form-urlencoded. Reused from the W3C WoT hypermedia vocabulary instead of defining a DEDL term.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.w3.org/2019/wot/hypermedia"/>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3.org/2019/wot/json-schema#propertyName -->


    <owl:DatatypeProperty rdf:about="https://www.w3.org/2019/wot/json-schema#propertyName">
        <rdfs:comment xml:lang="en">Used on the DataSchema of a body field to state the JSON key under which it appears, which must match the API exactly.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://www.w3.org/2019/wot/json-schema"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#Property -->


    <owl:Class rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    


    <!-- https://schema.org/EntryPoint -->


    <owl:Class rdf:about="https://schema.org/EntryPoint"/>
    


    <!-- https://schema.org/Organization -->


    <owl:Class rdf:about="https://schema.org/Organization"/>
    


    <!-- https://schema.org/Person -->


    <owl:Class rdf:about="https://schema.org/Person"/>
    


    <!-- https://w3id.org/dedl#API -->


    <owl:Class rdf:about="https://w3id.org/dedl#API">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Interface"/>
        <rdfs:comment xml:lang="en">Application Programming Interface; a subclass of Interface representing a component whose primary role is to be an entry point into the data ecosystem. DEDL deliberately does not apply API to every component that exposes a technical interface, as almost every component does. Where a component has a more specific functional type (e.g. IdentityProvider, Communication, DataStorage), that type is used instead and the component carries its Endpoints directly. API is therefore reserved for components that exist in order to be the interface: typically coordinating several sub-services, or fronting a separate storage component.</rdfs:comment>
        <rdfs:label xml:lang="en">API</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AccessControlModel -->


    <owl:Class rdf:about="https://w3id.org/dedl#AccessControlModel">
        <rdfs:comment xml:lang="en">A conceptual framework defining how access to resources is managed, granted, and restricted.</rdfs:comment>
        <rdfs:label xml:lang="en">AccessControlModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AgreementStorage -->


    <owl:Class rdf:about="https://w3id.org/dedl#AgreementStorage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#PolicyStorage"/>
        <rdfs:comment xml:lang="en">A subclass of PolicyStorage where concluded contracts are stored, ensuring that agreements between Participants are documented and accessible.</rdfs:comment>
        <rdfs:label xml:lang="en">AgreementStorage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuditAndLogging -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuditAndLogging">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A component responsible for documenting activities within a data ecosystem to ensure transparency.</rdfs:comment>
        <rdfs:label xml:lang="en">AuditAndLogging</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Authentication -->


    <owl:Class rdf:about="https://w3id.org/dedl#Authentication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">A Process of a data ecosystem that verifies the identity of a user or entity. Its members are concrete processes; the general interaction pattern is described by AuthenticationPattern.</rdfs:comment>
        <rdfs:label xml:lang="en">Authentication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthenticationFactor -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthenticationFactor">
        <rdfs:comment xml:lang="en">An element used to verify the identity of a user or entity (e.g. password, token, biometrics).</rdfs:comment>
        <rdfs:label xml:lang="en">AuthenticationFactor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthenticationPattern -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthenticationPattern">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#OneWay"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#ThreeWay"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#TwoWay"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of interaction patterns for verifying an identity. A pattern classifies how an Authenticator works; it is not itself a Process of a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthenticationPattern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthenticationProtocol -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthenticationProtocol">
        <rdfs:comment xml:lang="en">A specification of the interactions or steps used to perform authentication.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthenticationProtocol</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthenticationRiskContext -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthenticationRiskContext">
        <rdfs:comment xml:lang="en">Contextual attributes (time, location, device) that affect authentication risk levels.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthenticationRiskContext</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthenticationScheme -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthenticationScheme">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#Bearer"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#ClientCredentials"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of the ways in which credentials are carried when calling an endpoint.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthenticationScheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Authenticator -->


    <owl:Class rdf:about="https://w3id.org/dedl#Authenticator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#IdentityAndAccessManagement"/>
        <rdfs:comment xml:lang="en">An Participant or component responsible for carrying out the authentication process.</rdfs:comment>
        <rdfs:label xml:lang="en">Authenticator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Authorization -->


    <owl:Class rdf:about="https://w3id.org/dedl#Authorization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">A Process of a data ecosystem that determines whether an entity may access a resource. Its members are concrete processes; the general interaction pattern is described by AuthorizationPattern.</rdfs:comment>
        <rdfs:label xml:lang="en">Authorization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthorizationArchitecture -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthorizationArchitecture">
        <rdfs:comment xml:lang="en">A subclass of IdentityAndAccessManagement representing a structural framework that defines how authorization decisions are made and enforced.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthorizationArchitecture</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#AuthorizationPattern -->


    <owl:Class rdf:about="https://w3id.org/dedl#AuthorizationPattern">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#Negotiate"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#Poll"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#Push"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of interaction patterns for reaching and delivering an access decision. A pattern classifies how an Authorizator works; it is not itself a Process of a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">AuthorizationPattern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Authorizator -->


    <owl:Class rdf:about="https://w3id.org/dedl#Authorizator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#IdentityAndAccessManagement"/>
        <rdfs:comment xml:lang="en">A participant or component that assesses permissions and enforces authorization decisions.</rdfs:comment>
        <rdfs:label xml:lang="en">Authorizator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Base -->


    <owl:Class rdf:about="https://w3id.org/dedl#Base">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Common superclass of everything a DEDL model describes as a named thing: data ecosystems, their elements (participants and technical elements), entities, policies and processes. Every instance carries a human-readable schema:name and should carry a schema:description. It replaces the attributes id, name and description of the Base class in the DEDL information model; the id is the IRI of the instance.</rdfs:comment>
        <rdfs:label xml:lang="en">Base</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Communication -->


    <owl:Class rdf:about="https://w3id.org/dedl#Communication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A mechanism through which participants in a data ecosystem exchange information and interact with each other.</rdfs:comment>
        <rdfs:label xml:lang="en">Communication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ContractAgreeing -->


    <owl:Class rdf:about="https://w3id.org/dedl#ContractAgreeing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Negotiating"/>
        <rdfs:comment xml:lang="en">A subclass of Negotiation representing the concluding process between data providers and consumers  when a policy is accepted by both parties and a contract is formed.</rdfs:comment>
        <rdfs:label xml:lang="en">ContractAgreeing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ContractOffering -->


    <owl:Class rdf:about="https://w3id.org/dedl#ContractOffering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Negotiating"/>
        <rdfs:comment xml:lang="en">A subclass of Negotiating representing the process where data offers are made available to potential consumers.</rdfs:comment>
        <rdfs:label xml:lang="en">ContractOffering</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ContractRequesting -->


    <owl:Class rdf:about="https://w3id.org/dedl#ContractRequesting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Negotiating"/>
        <rdfs:comment xml:lang="en">A subclass of Negotiating representing the process where potential data consumers request specific conditions for the use or access of data.</rdfs:comment>
        <rdfs:label xml:lang="en">ContractRequesting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataEcosystem -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataEcosystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Base"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#participant"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#process"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#technicalDataEcosystemElement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A socio-technical system in which participants share and manage data and associated processes.</rdfs:comment>
        <rdfs:label xml:lang="en">DataEcosystem</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataEcosystemElement -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataEcosystemElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Base"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#inDataEcosystem"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An element within a data ecosystem that contributes to its functionality and processes.</rdfs:comment>
        <rdfs:label xml:lang="en">DataEcosystemElement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataExchanging -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataExchanging">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Transacting"/>
        <rdfs:comment xml:lang="en">A subclass of Transaction that represents the process that facilitates the transfer of data within a data ecosystem between Participants.</rdfs:comment>
        <rdfs:label xml:lang="en">DataExchanging</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataOffering -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataOffering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Publishing"/>
        <rdfs:comment xml:lang="en">A sublcass of Publishing representing the process where participants make their data available to others in the data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">DataOffering</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataSpaceConnector -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataSpaceConnector">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Interface"/>
        <rdfs:comment xml:lang="en">A subclass of Interface enabling secure and standardized interaction within data spaces (i.e., specialized realizations of data ecosystems).</rdfs:comment>
        <rdfs:label xml:lang="en">DataSpaceConnector</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataStorage -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataStorage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Storage"/>
        <rdfs:comment xml:lang="en">A subclass of Storage dedicated to storing data within a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">DataStorage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#DataStoring -->


    <owl:Class rdf:about="https://w3id.org/dedl#DataStoring">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Publishing"/>
        <rdfs:comment xml:lang="en">A subclass of Publishing representing the process that ensures datasets are stored securely, either centrally or decentrally, depending on the architecture of the data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">DataStoring</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Decision -->


    <owl:Class rdf:about="https://w3id.org/dedl#Decision">
        <rdfs:comment xml:lang="en">An outcome regarding an authorization request, e.g. Allow or Deny.</rdfs:comment>
        <rdfs:label xml:lang="en">Decision</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Endpoint -->


    <owl:Class rdf:about="https://w3id.org/dedl#Endpoint">
        <rdfs:subClassOf rdf:resource="https://schema.org/EntryPoint"/>
        <rdfs:comment xml:lang="en">HTTP(S) endpoint of an API that can be invoked by a process. DEDL 0.1 deliberately covers REST only; protocol-specific Endpoint subclasses are deferred.</rdfs:comment>
        <rdfs:label xml:lang="en">Endpoint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Entity -->


    <owl:Class rdf:about="https://w3id.org/dedl#Entity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Base"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#identity"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/didl#Identity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#policy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#Policy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any identifiable object of a participant within the data ecosystem, e.g. a device or digital resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Finding -->


    <owl:Class rdf:about="https://w3id.org/dedl#Finding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">An optional process that enables information or data to be found within a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Finding</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#GUI -->


    <owl:Class rdf:about="https://w3id.org/dedl#GUI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Interface"/>
        <rdfs:comment xml:lang="en">Graphical User Interface; a subclass of Interface representing an interface through which users can visually interact with components of a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">GUI</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#HttpLocation -->


    <owl:Class rdf:about="https://w3id.org/dedl#HttpLocation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#Header"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#Path"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of the places in an HTTP request in which a parameter can be carried. The request body is not part of this enumeration; it is described through requestHttpBodySchema.</rdfs:comment>
        <rdfs:label xml:lang="en">HttpLocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#HttpParameter -->


    <owl:Class rdf:about="https://w3id.org/dedl#HttpParameter">
        <rdfs:comment xml:lang="en">A single parameter of an HTTP request that is carried outside the body, i.e. in the path or in a header.</rdfs:comment>
        <rdfs:label xml:lang="en">HttpParameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#HttpResponse -->


    <owl:Class rdf:about="https://w3id.org/dedl#HttpResponse">
        <rdfs:comment xml:lang="en">One possible response of an endpoint, identified by its status code and optionally carrying a body schema.</rdfs:comment>
        <rdfs:label xml:lang="en">HttpResponse</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#IdentityAndAccessManagement -->


    <owl:Class rdf:about="https://w3id.org/dedl#IdentityAndAccessManagement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A framework ensuring that only authorized Participants have access to a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">IdentityAndAccessManagement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#IdentityProvider -->


    <owl:Class rdf:about="https://w3id.org/dedl#IdentityProvider">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#IdentityAndAccessManagement"/>
        <rdfs:comment xml:lang="en">A subclass of IdentityAndAccessManagement representing a component responsible for managing digital identities, facilitating onboarding and offboarding processes in a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">IdentityProvider</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Individual -->


    <owl:Class rdf:about="https://w3id.org/dedl#Individual">
        <rdfs:subClassOf rdf:resource="https://schema.org/Person"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Participant"/>
        <owl:disjointWith rdf:resource="https://w3id.org/dedl#Organization"/>
        <rdfs:comment xml:lang="en">A subclass of Participant representing a natural person.</rdfs:comment>
        <rdfs:label xml:lang="en">Individual</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Interface -->


    <owl:Class rdf:about="https://w3id.org/dedl#Interface">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">An access point for participants to join and interact within a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Interface</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Negotiating -->


    <owl:Class rdf:about="https://w3id.org/dedl#Negotiating">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">An optional process where participants discuss and agree on policies leading to contracts within a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Negotiating</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Offboarding -->


    <owl:Class rdf:about="https://w3id.org/dedl#Offboarding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">A mandatory process for removing participant identities from a data ecosystem ensuring compliance or voluntary exit.</rdfs:comment>
        <rdfs:label xml:lang="en">Offboarding</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#OfferStorage -->


    <owl:Class rdf:about="https://w3id.org/dedl#OfferStorage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#PolicyStorage"/>
        <rdfs:comment xml:lang="en">A subclass of PolicyStorage where data offers are stored, allowing participants in a data ecosystem to publish and manage their available datasets or services.</rdfs:comment>
        <rdfs:label xml:lang="en">OfferStorage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Onboarding -->


    <owl:Class rdf:about="https://w3id.org/dedl#Onboarding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">A mandatory process that manages the creation of digital identities, enabling Participants to access a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Onboarding</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Organization -->


    <owl:Class rdf:about="https://w3id.org/dedl#Organization">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Participant"/>
        <rdfs:comment xml:lang="en">A subclass of Participant representing a legal entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ParameterEncoding -->


    <owl:Class rdf:about="https://w3id.org/dedl#ParameterEncoding">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#Base64Url"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of the transformations an endpoint requires before a parameter value is placed into the request. Not reused from jsonschema:contentEncoding, which describes how the content of a StringSchema value is stored, is limited to the RFC values up to base64, and would leave the value itself encoded in the model.</rdfs:comment>
        <rdfs:label xml:lang="en">ParameterEncoding</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ParameterMapping -->


    <owl:Class rdf:about="https://w3id.org/dedl#ParameterMapping">
        <rdfs:comment xml:lang="en">Connects a value of the process with a field of a message. Referenced from a Task through mapsInput or mapsOutput; the mapping itself is direction-agnostic, which is why source and target carry mirrored meanings depending on which of the two properties points at it.</rdfs:comment>
        <rdfs:label xml:lang="en">ParameterMapping</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Participant -->


    <owl:Class rdf:about="https://w3id.org/dedl#Participant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#DataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A stakeholder participating in or operating the data ecosystem (either an Individual or Organization).</rdfs:comment>
        <rdfs:label xml:lang="en">Participant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Policy -->


    <owl:Class rdf:about="https://w3id.org/dedl#Policy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Base"/>
        <rdfs:comment xml:lang="en">A set of rules or guidelines that govern data usage, sharing, and access.</rdfs:comment>
        <rdfs:label xml:lang="en">Policy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#PolicyLanguage -->


    <owl:Class rdf:about="https://w3id.org/dedl#PolicyLanguage">
        <rdfs:comment xml:lang="en">A formal language for defining and expressing policies.</rdfs:comment>
        <rdfs:label xml:lang="en">PolicyLanguage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#PolicyStorage -->


    <owl:Class rdf:about="https://w3id.org/dedl#PolicyStorage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Storage"/>
        <rdfs:comment xml:lang="en">A subclass of storage that stores the conditions under which access to resources in a data ecosystem is granted and how they may be used.</rdfs:comment>
        <rdfs:label xml:lang="en">PolicyStorage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Process -->


    <owl:Class rdf:about="https://w3id.org/dedl#Process">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Base"/>
        <rdfs:subClassOf rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#byDataEcosystem"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#DataEcosystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A series of operations or activities performed within the data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Process</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Publishing -->


    <owl:Class rdf:about="https://w3id.org/dedl#Publishing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">An optional process that makes data discoverable and allows its findability through catalogs or metadata integration.</rdfs:comment>
        <rdfs:label xml:lang="en">Publishing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Reference -->


    <owl:Class rdf:about="https://w3id.org/dedl#Reference">
        <rdfs:comment xml:lang="en">Deprecated since 1.0.0. In the DEDL information model, Reference is the type of attributes that point to another object by its id, e.g. inDataEcosystem or byDataEcosystem. In RDF, these references are object properties that point directly to the IRI of the target, so the class is no longer needed.</rdfs:comment>
        <rdfs:label xml:lang="en">Reference</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#RunTimeEnvironment -->


    <owl:Class rdf:about="https://w3id.org/dedl#RunTimeEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">An infrastructure required for executing services within a data ecosystem, providing the necessary computing resources.</rdfs:comment>
        <rdfs:label xml:lang="en">RunTimeEnvironment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Service -->


    <owl:Class rdf:about="https://w3id.org/dedl#Service">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A service developed to address specific needs within a data ecosystem, often involving data processing or visualization.</rdfs:comment>
        <rdfs:label xml:lang="en">Service</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#ServiceExecuting -->


    <owl:Class rdf:about="https://w3id.org/dedl#ServiceExecuting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Transacting"/>
        <rdfs:comment xml:lang="en">A  subclass of Transaction representing the process that enables third-party services execution to generate additional value from the managed data in a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">ServiceExecuting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Status -->


    <owl:Class rdf:about="https://w3id.org/dedl#Status">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/dedl#ACTIVE"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#ERROR"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#INACTIVE"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#MAINTENANCE"/>
                    <rdf:Description rdf:about="https://w3id.org/dedl#UPDATE"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Enumeration of possible status values for an element.</rdfs:comment>
        <rdfs:label xml:lang="en">Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Storage -->


    <owl:Class rdf:about="https://w3id.org/dedl#Storage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#TechnicalDataEcosystemElement"/>
        <rdfs:comment xml:lang="en">A component where various types of information are stored in a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Storage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#TechnicalDataEcosystemElement -->


    <owl:Class rdf:about="https://w3id.org/dedl#TechnicalDataEcosystemElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#DataEcosystemElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/dedl#operatedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/dedl#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A subclass of DataEcosystemElement focused on technical components necessary for the operation of a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">TechnicalDataEcosystemElement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/dedl#Transacting -->


    <owl:Class rdf:about="https://w3id.org/dedl#Transacting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/dedl#Process"/>
        <rdfs:comment xml:lang="en">A mandatory process that enables the exchange or transfer of data or other resources between Participants within a data ecosystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Transacting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/didl#Identity -->


    <owl:Class rdf:about="https://w3id.org/didl#Identity">
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/didl"/>
    </owl:Class>
    


    <!-- https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource -->


    <owl:Class rdf:about="https://www.irit.fr/recherches/MELODI/ontologies/BBO#DataResource"/>
    


    <!-- https://www.irit.fr/recherches/MELODI/ontologies/BBO#Expression -->


    <owl:Class rdf:about="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Expression">
        <rdfs:isDefinedBy rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO"/>
    </owl:Class>
    


    <!-- https://www.irit.fr/recherches/MELODI/ontologies/BBO#InputSet -->


    <owl:Class rdf:about="https://www.irit.fr/recherches/MELODI/ontologies/BBO#InputSet">
        <rdfs:isDefinedBy rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO"/>
    </owl:Class>
    


    <!-- https://www.irit.fr/recherches/MELODI/ontologies/BBO#Process -->


    <owl:Class rdf:about="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Process">
        <rdfs:isDefinedBy rdf:resource="https://www.irit.fr/recherches/MELODI/ontologies/BBO"/>
    </owl:Class>
    


    <!-- https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task -->


    <owl:Class rdf:about="https://www.irit.fr/recherches/MELODI/ontologies/BBO#Task"/>
    


    <!-- https://www.w3.org/2019/wot/json-schema#DataSchema -->


