    "@value" : "A subclass of storage that stores the conditions under which access to resources in a data ecosystem is granted and how they may be used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PolicyStorage"
