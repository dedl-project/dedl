  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/dedl#AuthenticationFactor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An authentication factor requiring two or more independent credentials."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MultiFactor"
  } ]
}, {
  "@id" : "https://w3id.org/dedl#Negotiate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
