    "@id" : "https://w3id.org/dedl#AuthorizationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An authorization pattern in which the parties negotiate or exchange data before access is decided."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Negotiate"
  } ]
}, {
  "@id" : "https://w3id.org/dedl#Negotiating",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An optional process where participants discuss and agree on policies leading to contracts within a data ecosystem."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Negotiating"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/dedl#Process"
